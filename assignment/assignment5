import csv
import io

RAW = """station,date,pm25
Adyar,2026-10-01,48
Adyar,2026-10-02,NA
Adyar,2026-10-03,
Guindy,2026-10-01,95
Guindy,2026-10-02,-5
Guindy,2026-10-03,121
Guindy,2026-10-04,1250
"""

def load_clean(text):
    """Returns (station, date, pm25) tuples for valid, non-negative readings <= 999 only."""
    rows = []
    reader = csv.DictReader(io.StringIO(text.strip()))
    for r in reader:
        val_str = (r.get("pm25") or "").strip()
        if val_str == "" or val_str.upper() == "NA":
            continue
        try:
            val = float(val_str)
        except ValueError:
            continue
        if val < 0 or val > 999:
            continue
        rows.append((r["station"].strip(), r["date"].strip(), val))
    return rows

def min_max(values):
    if not values:
        return []
    mn, mx = min(values), max(values)
    if mx == mn:
        return [0.0 for _ in values]
    return [round((v - mn) / (mx - mn), 3) for v in values]

clean = load_clean(RAW)
print(clean)
print(min_max([pm for _, _, pm in clean]))

