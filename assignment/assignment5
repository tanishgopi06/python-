SIMATS Algorithmic Pseudocode — Procedure ACQUIRE_AND_INGEST
ALGORITHM ACQUIRE_AND_INGEST(csv_file_list, db_connection)
INPUT:  csv_file_list (list of daily CSV file paths), db_connection (active SQLite handle)
OUTPUT: total_inserted (integer count of clean records stored)
BEGIN
    SET total_inserted <- 0
    CALL db_connection.EXECUTE("CREATE TABLE IF NOT EXISTS stations (...)")
    CALL db_connection.EXECUTE("CREATE TABLE IF NOT EXISTS readings (...)")
    FOR EACH file_path IN csv_file_list DO
        OPEN file_path FOR READING AS stream
        READ header_row FROM stream
        INITIALIZE batch_records <- EMPTY LIST
        FOR EACH raw_row IN stream DO
            SET clean_row <- CALL CLEAN_AND_NORMALISE_ROW(raw_row)
            IF clean_row IS NOT NULL THEN
                APPEND clean_row TO batch_records
            END IF
        END FOR
        CLOSE stream
        CALL db_connection.EXECUTEMANY("INSERT OR IGNORE INTO readings VALUES (?,?,?,?,?,?,?)", batch_records)
        SET total_inserted <- total_inserted + LENGTH(batch_records)
    END FOR
    CALL db_connection.COMMIT()
    RETURN total_inserted
END

