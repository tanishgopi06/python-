2.6 Completed Round Robin C program
#include <stdio.h>
#define N 4
int main(void) {
    const char *name[N] = {"P1","P2","P3","P4"};
    int arrival[N] = {0,1,2,3}, burst[N] = {8,4,9,5}, quantum = 3;
    int left[N], finish[N], queue[64], head=0, tail=0, added[N]={0};
    for (int i=0;i<N;i++) left[i]=burst[i];
    int time=0, done=0;
    queue[tail++]=0; added[0]=1;
    printf("Gantt:");
    while (done<N) {
        if (head==tail) {
            for (int i=0;i<N;i++)
                if (!added[i] && left[i]>0) {
                    if (time<arrival[i]) time=arrival[i];
                    queue[tail++]=i; added[i]=1; break;
                }
        }
        int p=queue[head++];
        int run = left[p] < quantum ? left[p] : quantum;
        int old=time; time+=run; left[p]-=run;
        printf(" %s(%d-%d)",name[p],old,time);
        for (int i=0;i<N;i++)
            if (!added[i] && arrival[i]<=time) {
                queue[tail++]=i; added[i]=1;
            }
        if (left[p]>0) queue[tail++]=p;
        else { finish[p]=time; done++; }
    }
    double tw=0,tt=0;
    printf("\nProcess TAT WT\n");
    for(int i=0;i<N;i++){
        int tat=finish[i]-arrival[i], wt=tat-burst[i];
        tt+=tat; tw+=wt;
        printf("%-7s %4d %3d\n",name[i],tat,wt);
    }
    printf("Average TAT = %.2f, average WT = %.2f\n",tt/N,tw/N);
    return 0;
}

