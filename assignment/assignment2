#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>
 
#define CAMERAS 64
typedef struct { int first, last; long *counts; } Work;
 
void *process_frames(void *arg) {
    Work *w = (Work *)arg;
    for (int c=w->first; c<w->last; ++c) {
        /* Replace this loop with actual frame decoding/plate recognition. */
        long detected = 0;
        for (int f=0; f<100000; ++f)
            detected += (f % 997 == 0);
        w->counts[c] = detected;
    }
    return NULL;
}
 
int main(int argc, char **argv) {
    int workers = argc > 1 ? atoi(argv[1]) : 4;
    if (workers < 1 || workers > CAMERAS) return 1;
    pthread_t *threads = calloc((size_t)workers, sizeof *threads);
    Work *work = calloc((size_t)workers, sizeof *work);
    long counts[CAMERAS] = {0};
    int chunk = (CAMERAS + workers - 1) / workers;
    for (int i=0; i<workers; ++i) {
        work[i].first = i * chunk;
        work[i].last = work[i].first + chunk;
        if (work[i].last > CAMERAS) work[i].last = CAMERAS;
        work[i].counts = counts;
        pthread_create(&threads[i], NULL, process_frames, &work[i]);
    }
    for (int i=0; i<workers; ++i) pthread_join(threads[i], NULL);
    long total=0;
    for (int i=0; i<CAMERAS; ++i) total += counts[i];
    printf("Workers=%d, cameras=%d, total detections=%ld\n",
           workers, CAMERAS, total);
    free(threads); free(work);
    return 0;
}

